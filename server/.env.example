# Required: MongoDB connection string. Replace with your Atlas or local URI.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hustlehub?retryWrites=true&w=majority

# Required: Generate a unique secret for signing authentication tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Free local setup with Ollama: https://ollama.com
OPENAI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2

# Alternatively, use OpenAI by setting OPENAI_API_KEY and removing/commenting
# OPENAI_BASE_URL. API usage may incur charges.
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
